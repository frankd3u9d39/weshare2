{
  "name": "weshare",
  "version": "1.1.1",
  "description": "Premium offline-first local file sharing desktop application",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json -w",
    "dev": "concurrently -k -s first \"npm run dev:renderer\" \"npm run dev:main\" \"wait-on http://127.0.0.1:5773 && electron .\"",
    "build:main": "tsc -p tsconfig.main.json && node -e \"const fs = require('fs'); fs.mkdirSync('dist/main/main', { recursive: true }); fs.copyFileSync('src/main/logo.png', 'dist/main/main/logo.png'); fs.copyFileSync('src/main/printScreen.html', 'dist/main/main/printScreen.html');\"",
    "build:renderer": "tsc -p tsconfig.renderer.json && vite build",
    "build": "npm run build:main && npm run build:renderer",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "package:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "lucide-react": "^0.395.0",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.3",
    "selfsigned": "2.4.1",
    "ws": "^8.17.0",
    "yauzl": "2.10.0",
    "yazl": "2.5.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@types/yauzl": "2.10.3",
    "@types/yazl": "2.4.5",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.0.1",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.weshare.app",
    "productName": "Weshare",
    "publish": [
      {
        "provider": "github",
        "owner": "frankd3u9d39",
        "repo": "Weshare2"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Weshare"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "tar.gz"
    }
  }
}
